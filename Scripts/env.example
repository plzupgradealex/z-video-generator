# App Store Connect / signing credentials for the Z Video Generator scripts.
# Copy to Scripts/env.local (gitignored) and fill in, then:  source Scripts/env.local
#
# These are ACCOUNT-LEVEL — the same values work for Muxy and Z Video Generator.

# Apple Developer Team ID (10 chars). Find it: developer.apple.com → Membership.
export Z_TEAM_ID="ABCD123XYZ"

# App Store Connect API key. Create at: App Store Connect → Users and Access →
# Keys (Admin access). The Key ID is shown in the table; the Issuer ID is the
# UUID at the top of that page. The .p8 (downloadable ONCE) goes to
# ~/.appstoreconnect/private_keys/AuthKey_<KEY_ID>.p8
export Z_API_KEY_ID=""
export Z_API_ISSUER=""

# --- Direct distribution only (Developer-ID notarization). Leave blank for the
#     App Store flow. App-specific password: appleid.apple.com → Sign-In &
#     Security → App-Specific Passwords.
export Z_APPLE_ID=""
export Z_APP_SPECIFIC_PASSWORD=""
